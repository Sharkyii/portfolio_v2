# Anthropic (bio/sonnet generation)
ANTHROPIC_API_KEY=

# GitHub (open-source PR dashboard)
GITHUB_TOKEN=
GITHUB_USERNAME=Sharkyii

# Google Calendar / Meet (meeting booking)
# Obtain GOOGLE_REFRESH_TOKEN by running tools/meeting_book/google_auth_setup.py once, locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Outbound email confirmations — use a Gmail App Password, not your real password:
# https://myaccount.google.com/apppasswords
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000
